    <!-- ========== PAGE HEADER ========== -->
    <section class="page-header">
        <div class="container">
            <h1>🎥 Metode Think-Aloud</h1>
            <p>Rekam layar dan wajahmu saat menjelaskan konsep fluida dinamis menggunakan simulasi PhET</p>
        </div>
    </section>

    <!-- ========== PAGE CONTENT ========== -->
    <section class="page-content">
        <div class="container">
            <div class="thinkaloud-container">

                <!-- KIRI: Panduan -->
                <div class="thinkaloud-card">
                    <h3>📋 Panduan Rekaman</h3>
                    <ol style="padding-left:20px; margin-bottom:20px;">
                        <li style="margin-bottom:12px; list-style:decimal;">Buka simulasi PhET di halaman <a href="simulasi.html" style="color:var(--accent); font-weight:600;">Simulasi</a>.</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Siapkan aplikasi perekam layar (OBS Studio, Loom, atau Screencast-O-Matic).</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Aktifkan perekaman <strong>layar + webcam (Face Cam)</strong> secara bersamaan.</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Jelaskan konsep <strong>Debit, Kontinuitas, atau Bernoulli</strong> sambil menggunakan simulasi.</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Durasi maksimal <strong>5 menit</strong>.</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Unggah video ke YouTube (mode <strong>unlisted</strong>).</li>
                        <li style="margin-bottom:12px; list-style:decimal;">Salin link video dan tempelkan pada kotak di halaman <a href="refleksi.html" style="color:var(--accent); font-weight:600;">Refleksi</a>.</li>
                    </ol>

                    <a href="refleksi.html" class="btn btn-primary">
                        <i class="fas fa-pen-fancy"></i> Isi Jurnal Refleksi
                    </a>
                </div>

                <!-- KANAN: Tips & Rubrik -->
                <div class="thinkaloud-card">
                    <h3>💡 Tips Sukses</h3>
                    <ul>
                        <li style="margin-bottom:10px; list-style:disc;">Gunakan kalimat sendiri, jangan menghafal rumus!</li>
                        <li style="margin-bottom:10px; list-style:disc;">Tunjukkan simulasi dan tunjuk bagian yang sedang dijelaskan.</li>
                        <li style="margin-bottom:10px; list-style:disc;">Sebutkan apa yang kamu pikirkan saat melihat perubahan di simulasi.</li>
                        <li style="margin-bottom:10px; list-style:disc;">Hubungkan dengan contoh kehidupan sehari-hari.</li>
                    </ul>

                    <h3>📊 Rubrik Penilaian</h3>
                    <table style="width:100%; border-collapse:collapse; margin-top:10px; font-size:0.9rem;">
                        <thead>
                            <tr style="background:var(--primary); color:white;">
                                <th style="padding:8px 12px; text-align:left; border-radius:8px 0 0 0;">Aspek</th>
                                <th style="padding:8px 12px; text-align:left;">Kriteria Baik</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="padding:8px 12px; font-weight:600;">Kejelasan Suara</td>
                                <td style="padding:8px 12px;">Suara jelas dan terdengar dengan baik</td>
                            </tr>
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="padding:8px 12px; font-weight:600;">Penjelasan Konsep</td>
                                <td style="padding:8px 12px;">Menjelaskan konsep dengan benar dan terstruktur</td>
                            </tr>
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="padding:8px 12px; font-weight:600;">Penggunaan Simulasi</td>
                                <td style="padding:8px 12px;">Mengeksplorasi simulasi dan menghubungkan dengan konsep</td>
                            </tr>
                            <tr>
                                <td style="padding:8px 12px; font-weight:600; border-radius:0 0 0 8px;">Refleksi Metakognitif</td>
                                <td style="padding:8px 12px;">Menjelaskan strategi berpikir dan mengevaluasi pemahaman</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
